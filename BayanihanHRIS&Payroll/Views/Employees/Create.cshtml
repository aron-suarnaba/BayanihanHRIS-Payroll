@model BayanihanHRIS_Payroll.Models.Employee

@{
    ViewData["Title"] = "Add New Employee";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0"><i class="bi bi-person-plus"></i> Register New Employee</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Employee Identity Row -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="EmployeeNumber" class="form-label fw-bold"></label>
                                <input asp-for="EmployeeNumber" class="form-control" placeholder="e.g. 2026001" />
                                <span asp-validation-for="EmployeeNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="FirstName" class="form-label fw-bold"></label>
                                <input asp-for="FirstName" class="form-control" placeholder="Juan" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="LastName" class="form-label fw-bold"></label>
                                <input asp-for="LastName" class="form-control" placeholder="Dela Cruz" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Details Row -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="BirthDate" class="form-label fw-bold"></label>
                                <input asp-for="BirthDate" class="form-control" type="date" />
                                <span asp-validation-for="BirthDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DepartmentId" class="form-label fw-bold">Department</label>
                                <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.DepartmentId">
                                    <option value="">-- Select Department --</option>
                                </select>
                                <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4 text-muted">

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="link-secondary text-decoration-none">
                                <i class="bi bi-arrow-left"></i> Back to List
                            </a>
                            <button type="submit" class="btn btn-primary px-5 shadow-sm">
                                <i class="bi bi-check-circle"></i> Save Employee
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}