@model BayanihanHRIS_Payroll.Models.Employee

@{
    ViewData["Title"] = "Terminate/Delete Record";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger shadow">
                <div class="card-header bg-danger text-white text-center py-3">
                    <h4 class="mb-0"><i class="bi bi-exclamation-triangle-fill"></i> Confirm Deletion</h4>
                </div>
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <p class="fs-5">Are you sure you want to permanently delete this employee record?</p>
                        <hr />
                        <h3 class="text-primary mb-1">@Model.FirstName @Model.LastName</h3>
                        <p class="text-muted">Employee ID: <strong>#@Model.EmployeeNumber</strong></p>
                    </div>

                    <div class="bg-light p-3 rounded mb-4">
                        <div class="row small text-uppercase text-muted fw-bold">
                            <div class="col-6">Department</div>
                            <div class="col-6">Date Hired</div>
                        </div>
                        <div class="row mt-1">
                            <div class="col-6">@(Model.Department?.Name ?? "N/A")</div>
                            <div class="col-6">@Model.DateHired.ToString("MMM dd, yyyy")</div>
                        </div>
                    </div>

                    <div class="alert alert-warning py-2 small">
                        <i class="bi bi-info-circle me-2"></i>
                        Warning: This will also remove associated payroll history and logs.
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg shadow-sm">
                                <i class="bi bi-trash"></i> Permanently Delete
                            </button>
                            <a asp-action="Index" class="btn btn-link text-secondary-hover text-secondary text-decoration-none mt-2">
                                No, Keep Record (Back to List)
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>