@model BayanihanHRIS_Payroll.Models.Employee

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2" role="alert"></div>

    <!-- Personal Information Section -->
    <h6 class="text-primary border-bottom pb-2 mb-3">Personal Information</h6>
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <label asp-for="FirstName" class="form-label fw-bold small">First Name</label>
            <input asp-for="FirstName" class="form-control" placeholder="Juan" />
            <span asp-validation-for="FirstName" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="MiddleName" class="form-label fw-bold small">Middle Name</label>
            <input asp-for="MiddleName" class="form-control" placeholder="Santos" />
            <span asp-validation-for="MiddleName" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="LastName" class="form-label fw-bold small">Last Name</label>
            <input asp-for="LastName" class="form-control" placeholder="Dela Cruz" />
            <span asp-validation-for="LastName" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="BirthDate" class="form-label fw-bold small">Birth Date</label>
            <input asp-for="BirthDate" class="form-control" type="date" />
            <span asp-validation-for="BirthDate" class="text-danger small"></span>
        </div>
    </div>

    <!-- Employment Details Section -->
    <h6 class="text-primary border-bottom pb-2 mb-3">Employment Details</h6>
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <label asp-for="EmployeeNumber" class="form-label fw-bold small">Employee ID</label>
            <input asp-for="EmployeeNumber" class="form-control text-uppercase" placeholder="2026-001" />
            <span asp-validation-for="EmployeeNumber" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="DepartmentId" class="form-label fw-bold small text-secondary">
                <i class="bi bi-building me-1"></i> Assignment / Department
            </label>
            <select asp-for="DepartmentId" class="form-select shadow-sm border-primary-subtle" required>
                <option value="" disabled selected>-- Select Department --</option>
        
                <optgroup label="Administration & Finance">
                    <option value="Accounting">Accounting</option>
                    <option value="Human Resources">Human Resources</option>
                    <option value="Purchasing">Purchasing</option>
                </optgroup>

                <optgroup label="Operations">
                    <option value="DCC">DCC (Document Control)</option>
                    <option value="Information Technology">Information Technology</option>
                    <option value="Production">Production</option>
                </optgroup>

                <optgroup label="Quality & Growth">
                    <option value="Sales and Marketing">Sales and Marketing</option>
                    <option value="TSQA">TSQA (Tech Services & QA)</option>
                </optgroup>

                <option value="Others">Others / Unassigned</option>
            </select>
            <div class="form-text extra-small">Ensure the department matches the official plantilla.</div>
            <span asp-validation-for="DepartmentId" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="DateHired" class="form-label fw-bold small">Date Hired</label>
            <input asp-for="DateHired" class="form-control" type="date" />
        </div>
        <div class="col-md-6">
            <label asp-for="MonthlyRate" class="form-label fw-bold small">Monthly Rate</label>
            <div class="input-group">
                <span class="input-group-text">₱</span>
                <input asp-for="MonthlyRate" class="form-control" type="number" step="0.01" placeholder="0.00" />
            </div>
        </div>
    </div>

    <!-- Government & Banking Section -->
    <h6 class="text-primary border-bottom pb-2 mb-3">Government & Banking</h6>
    <div class="row g-3 mb-2">
        <div class="col-md-3">
            <label asp-for="SSSNumber" class="form-label fw-bold small">SSS #</label>
            <input asp-for="SSSNumber" class="form-control form-control-sm" placeholder="00-0000000-0" />
        </div>
        <div class="col-md-3">
            <label asp-for="PhilHealthNumber" class="form-label fw-bold small">PhilHealth #</label>
            <input asp-for="PhilHealthNumber" class="form-control form-control-sm" placeholder="00-000000000-0" />
        </div>
        <div class="col-md-3">
            <label asp-for="TINNumber" class="form-label fw-bold small">TIN #</label>
            <input asp-for="TINNumber" class="form-control form-control-sm" placeholder="000-000-000-000" />
        </div>
        <div class="col-md-3">
            <label asp-for="PagIbigNumber" class="form-label fw-bold small">Pag-IBIG #</label>
            <input asp-for="PagIbigNumber" class="form-control form-control-sm" placeholder="0000-0000-0000" />
        </div>
        <div class="col-md-6 mt-3">
            <label asp-for="BankAccountNumber" class="form-label fw-bold small">Bank Account Number</label>
            <input asp-for="BankAccountNumber" class="form-control" placeholder="1234567890" />
        </div>
        <div class="col-md-6 mt-3">
            <label asp-for="BankAccountName" class="form-label fw-bold small">Bank Account Name</label>
            <input asp-for="BankAccountName" class="form-control" placeholder="JUAN S DELA CRUZ" />
        </div>
    </div>

    <div class="modal-footer px-0 pb-0 mt-4 border-0">
        <button type="button" class="btn btn-link text-secondary text-decoration-none" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary px-5 shadow-sm fw-bold">
            <i class="bi bi-save me-2"></i>Save Employee
        </button>
    </div>
</form>